{
  "entities": {
    "PricingConfig": {
      "title": "PricingConfig",
      "description": "Authoritative database pricing configuration for painting contractors",
      "type": "object",
      "properties": {
        "clientSlug": { "type": "string", "maxLength": 64 },
        "clientName": { "type": "string", "maxLength": 128 },
        "hourlyLaborRate": { "type": "number" },
        "productionRate": { "type": "number" },
        "paintCostPerGallon": { "type": "number" },
        "paintCoverage": { "type": "number" },
        "sundriesMarkup": { "type": "number" },
        "fixedOverhead": { "type": "number" },
        "profitMargin": { "type": "number" },
        "doorLaborAllowance": { "type": "number" },
        "standardCeilingMultiplier": { "type": "number" },
        "highCeilingMultiplier": { "type": "number" },
        "rangePercent": { "type": "number" },
        "roundingIncrement": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clientSlug",
        "clientName",
        "hourlyLaborRate",
        "productionRate",
        "paintCostPerGallon",
        "paintCoverage",
        "sundriesMarkup",
        "fixedOverhead",
        "profitMargin",
        "doorLaborAllowance",
        "standardCeilingMultiplier",
        "highCeilingMultiplier",
        "rangePercent",
        "roundingIncrement"
      ]
    },
    "QuoteSubmission": {
      "title": "QuoteSubmission",
      "description": "Customer quote requests and inquiries calculated server-side or submitted for custom manual quote",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "clientSlug": { "type": "string", "maxLength": 64 },
        "service": { "type": "string", "enum": ["interior", "exterior"] },
        "quote_type": { "type": "string", "enum": ["instant", "manual"] },
        "pricing_mode": { "type": "string", "enum": ["instant_calculation", "manual_quote"] },
        "sqft": { "type": "number" },
        "ceiling": { "type": "string", "enum": ["standard", "high"] },
        "doors": { "type": "number" },
        "coats": { "type": "number", "enum": [1, 2] },
        "home_stories": { "type": "number", "enum": [1, 2] },
        "home_sqft": { "type": "number" },
        "siding_type": { "type": "string", "enum": ["wood", "stucco", "vinyl", "other"] },
        "fullName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "exactCalculatedQuote": { "type": "number" },
        "displayLow": { "type": "number" },
        "displayHigh": { "type": "number" },
        "pricing_snapshot": { "type": "object" },
        "submissionSource": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "clientSlug",
        "service",
        "fullName",
        "phone",
        "email",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/pricing_configs/{clientSlug}": {
      "schema": { "$ref": "#/entities/PricingConfig" },
      "description": "Pricing configurations per client organization"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/QuoteSubmission" },
      "description": "Quote submissions created by customer inquiries"
    }
  }
}
