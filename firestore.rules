rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Pricing configurations: public read for client quoting, admin write
    match /pricing_configs/{clientSlug} {
      allow get: if true;
      allow list: if true;
      allow write: if request.auth != null;
    }

    // Submissions: can be created by inquiring customers, read only by authorized admin
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll([
        'clientSlug', 'service', 'sqft', 'ceiling', 'doors', 'coats',
        'fullName', 'phone', 'email', 'exactCalculatedQuote', 'displayLow',
        'displayHigh', 'createdAt'
      ]) &&
      request.resource.data.sqft is number && request.resource.data.sqft > 0 &&
      request.resource.data.doors is number && request.resource.data.doors >= 0 &&
      (request.resource.data.coats == 1 || request.resource.data.coats == 2) &&
      (request.resource.data.ceiling == 'standard' || request.resource.data.ceiling == 'high') &&
      request.resource.data.fullName is string && request.resource.data.fullName.size() <= 128 &&
      request.resource.data.email is string && request.resource.data.email.size() <= 128 &&
      request.resource.data.phone is string && request.resource.data.phone.size() <= 32;

      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
